<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iot.platform.mapper.SensorDataMapper">

    <resultMap id="SensorDataMap" type="com.iot.platform.entity.SensorData">
        <id property="id" column="id"/>
        <result property="deviceId" column="device_id"/>
        <result property="deviceCode" column="device_code"/>
        <result property="deviceName" column="device_name"/>
        <result property="temperature" column="temperature"/>
        <result property="humidity" column="humidity"/>
        <result property="airQuality" column="air_quality"/>
        <result property="reportTime" column="report_time"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sensor_data (device_id, temperature, humidity, air_quality, report_time)
        VALUES (#{deviceId}, #{temperature}, #{humidity}, #{airQuality}, #{reportTime})
    </insert>

    <sql id="queryCondition">
        <where>
            <if test="deviceId != null">AND sd.device_id = #{deviceId}</if>
            <if test="startTime != null">AND sd.report_time &gt;= #{startTime}</if>
            <if test="endTime != null">AND sd.report_time &lt;= #{endTime}</if>
        </where>
    </sql>

    <select id="findPage" resultMap="SensorDataMap">
        SELECT sd.*, d.device_code, d.device_name
        FROM sensor_data sd
        LEFT JOIN device d ON sd.device_id = d.id
        <include refid="queryCondition"/>
        ORDER BY sd.report_time DESC
    </select>

    <select id="findForExport" resultMap="SensorDataMap">
        SELECT sd.*, d.device_code, d.device_name
        FROM sensor_data sd
        LEFT JOIN device d ON sd.device_id = d.id
        <include refid="queryCondition"/>
        ORDER BY sd.report_time DESC
    </select>
</mapper>
